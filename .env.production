# Production Environment Variables
# Copy this file to .env and update with your production values

# Database Configuration
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_NAME=chatflow_api
DB_USER=chatflow_user

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECURE_STRING_MIN_32_CHARS

# ChatFlow API Configuration
CHATFLOW_API_KEY=CHANGE_THIS_TO_SECURE_API_KEY
CHATFLOW_API_URL=http://chatflow-api-2:3000

# Server Configuration
SERVER_URL=https://your-domain.com
WS_SERVER_URL=wss://your-domain.com

# Webhook Configuration
WEBHOOK_SECRET=CHANGE_THIS_TO_RANDOM_WEBHOOK_SECRET

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Application Configuration
NODE_ENV=production
PORT=8090

# ChatFlow Instances
CHATFLOW_INSTANCE_1=http://chatflow-api-1:3000
CHATFLOW_INSTANCE_2=http://chatflow-api-2:3000
